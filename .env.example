# このファイルをコピーして .env.local を作り、値を入れてください（.env.local は Git に入れない）
#   cp .env.example .env.local

# ログイン用のパスワード
# ローカル開発中は短い固定パスワードでよい。Vercel に公開するときは長いパスワードにする
APP_PASSWORD=

# ログイン状態（Cookie）の署名に使う秘密の値。32 文字以上のランダムな文字列にする
#   作り方: openssl rand -base64 32
SESSION_SECRET=

# Neon（PostgreSQL）の接続先
DATABASE_URL=
